#!/usr/bin/env bash
#MISE description="Run plugin tests - install and execute tool"
set -euo pipefail

mise plugin link --force eclipse-jdtls .
mise cache clear
mise install eclipse-jdtls@1.60.0

# Capture and display the output while also verifying it
output=$(mise exec "eclipse-jdtls@1.60.0" -- "jdtls" --version)
echo "eclipse-jdtls output: $output"

if echo "$output" | grep -q 'eclipse-jdtls@1.60.0'; then
    echo "✓ Tests passed"
else
    echo "✗ Test failed: expected version eclipse-jdtls@1.60.0"
    exit 1
fi
